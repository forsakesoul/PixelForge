# 存储驱动：fs（本地）/ blob（Vercel）
# 不设置时：有 VERCEL=1 自动选 blob，否则 fs
STORAGE_DRIVER=fs

# 本地文件根目录（fs 模式）— 默认为 server 启动目录
# STORAGE_FS_ROOT=/absolute/path

# Vercel Blob 凭据（Vercel 项目自动注入；本地联调时手动配置）
BLOB_READ_WRITE_TOKEN=

# 文件 TTL（毫秒）
# fs 默认 86400000（24h）
# blob 默认 300000（5min）
FILE_TTL_MS=

# 配额上限（字节）— 默认 800MB（保留 200MB 缓冲，对应 Vercel Blob 1GB 免费额度）
QUOTA_LIMIT_BYTES=

# 清理接口鉴权 token
CLEANUP_SECRET=replace-with-random-string

# 本地开发端口
PORT=3001
